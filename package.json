{
  "name": "@aikit/prompts",
  "version": "0.1.0",
  "description": "Lightweight, zero-dep, type-safe LLM prompt management for TypeScript: template literal-typed variables, semver versioning, deterministic A/B split testing, per-version cost tracking, hot-reload sources, provider-agnostic output. Drop-in companion for Vercel AI SDK / OpenAI / Anthropic. Open-source alternative to PromptLayer / Helicone / Humanloop.",
  "type": "module",
  "license": "MIT",
  "author": "Mykhailo Kryvytskyi",
  "homepage": "https://github.com/j09822475-dev/aikit-prompts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j09822475-dev/aikit-prompts.git"
  },
  "bugs": {
    "url": "https://github.com/j09822475-dev/aikit-prompts/issues"
  },
  "keywords": [
    "prompt",
    "prompts",
    "prompt-management",
    "prompt-template",
    "prompt-engineering",
    "prompt-versioning",
    "llm",
    "llmops",
    "ai",
    "ai-sdk",
    "openai",
    "anthropic",
    "vercel-ai-sdk",
    "ab-testing",
    "split-testing",
    "type-safe",
    "template-literal-types",
    "typescript",
    "zero-dep",
    "edge-runtime",
    "cloudflare-workers",
    "vercel-edge",
    "bun",
    "deno",
    "langchain-alternative",
    "promptlayer-alternative",
    "humanloop-alternative",
    "helicone-alternative",
    "cost-tracking"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "PLAN.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./versioning": {
      "types": "./dist/versioning/index.d.ts",
      "import": "./dist/versioning/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./cost": {
      "types": "./dist/cost/index.d.ts",
      "import": "./dist/cost/index.js"
    },
    "./sources": {
      "types": "./dist/sources/index.d.ts",
      "import": "./dist/sources/index.js"
    },
    "./sources/fs": {
      "types": "./dist/sources/fs.d.ts",
      "import": "./dist/sources/fs.js"
    },
    "./sources/http": {
      "types": "./dist/sources/http.d.ts",
      "import": "./dist/sources/http.js"
    },
    "./sources/memory": {
      "types": "./dist/sources/memory.d.ts",
      "import": "./dist/sources/memory.js"
    },
    "./adapters/openai": {
      "types": "./dist/adapters/openai/index.d.ts",
      "import": "./dist/adapters/openai/index.js"
    },
    "./adapters/anthropic": {
      "types": "./dist/adapters/anthropic/index.d.ts",
      "import": "./dist/adapters/anthropic/index.js"
    },
    "./adapters/ai-sdk": {
      "types": "./dist/adapters/ai-sdk/index.d.ts",
      "import": "./dist/adapters/ai-sdk/index.js"
    },
    "./adapters/langchain": {
      "types": "./dist/adapters/langchain/index.d.ts",
      "import": "./dist/adapters/langchain/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest run --typecheck",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "format": "prettier --write \"**/*.{ts,md,json}\"",
    "publint": "publint",
    "attw": "attw --pack .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build && npm run publint && npm run attw && npm run size"
  },
  "peerDependencies": {
    "ai": ">=3.0.0",
    "openai": ">=4.0.0",
    "@anthropic-ai/sdk": ">=0.27.0",
    "@langchain/core": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "ai": { "optional": true },
    "openai": { "optional": true },
    "@anthropic-ai/sdk": { "optional": true },
    "@langchain/core": { "optional": true }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@arethetypeswrong/cli": "^0.16.0",
    "@langchain/core": "^0.3.0",
    "@size-limit/preset-small-lib": "^11.1.0",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "ai": "^3.4.0",
    "eslint": "^8.57.0",
    "openai": "^4.60.0",
    "prettier": "^3.2.0",
    "publint": "^0.2.0",
    "size-limit": "^11.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/index.js",
      "limit": "9 KB"
    },
    {
      "name": "errors",
      "path": "dist/errors/index.js",
      "limit": "0.6 KB"
    },
    {
      "name": "versioning",
      "path": "dist/versioning/index.js",
      "limit": "1.5 KB"
    },
    {
      "name": "testing",
      "path": "dist/testing/index.js",
      "limit": "1 KB"
    },
    {
      "name": "cost",
      "path": "dist/cost/index.js",
      "limit": "2 KB"
    },
    {
      "name": "sources/fs",
      "path": "dist/sources/fs.js",
      "limit": "1 KB"
    },
    {
      "name": "sources/http",
      "path": "dist/sources/http.js",
      "limit": "0.8 KB"
    },
    {
      "name": "adapters/openai",
      "path": "dist/adapters/openai/index.js",
      "limit": "0.6 KB"
    },
    {
      "name": "adapters/anthropic",
      "path": "dist/adapters/anthropic/index.js",
      "limit": "0.6 KB"
    },
    {
      "name": "adapters/ai-sdk",
      "path": "dist/adapters/ai-sdk/index.js",
      "limit": "0.6 KB"
    },
    {
      "name": "adapters/langchain",
      "path": "dist/adapters/langchain/index.js",
      "limit": "0.6 KB"
    }
  ]
}
